#!/usr/bin/env bash
# git pre-push hook (installed by `make hook`): runs the slow checks (STL export with bed fit, renders, Orca project
# meshes), then refuses the push when they failed or rewrote tracked files (renders, Orca projects): review, commit
# them, then push again.
# Skip once with `git push --no-verify`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
# the check reads the working tree: with uncommitted changes in its inputs it would not test what is pushed
dirty=$(git status --porcelain -- mechanical/scad tools scripts)
if [ -n "$dirty" ]; then
    echo "pre-push: uncommitted changes in the check's inputs, commit or stash them, then push again:"
    echo "$dirty" | sed 's/^/   /'
    exit 1
fi
# modified tracked files with their content hash: a file already modified and rewritten again by the check is seen too
snap() { git ls-files -m | while IFS= read -r f; do echo "$(git hash-object -- "$f" 2>/dev/null || echo deleted) $f"; done | sort; }
before=$(snap)
scripts/check.sh stl renders meshes || { echo "pre-push: check failed, push refused"; exit 1; }
changed=$(comm -13 <(echo "$before") <(snap) | cut -d" " -f2-)
if [ -n "$changed" ]; then
    echo "pre-push: the check rewrote these tracked files, commit them and push again:"
    echo "$changed" | sed 's/^/   /'
    exit 1
fi
